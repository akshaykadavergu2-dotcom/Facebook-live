# Server Port (must be 3000 in AI Studio preview)
PORT=3000
NODE_ENV=development

# 32+ character secret used to encrypt stored Facebook RTMP stream keys (AES-256-GCM)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="replace_with_32_byte_random_hex_secret"

# Optional: Set a studio operator password to enforce authentication on all API & WebSocket endpoints.
# Strongly recommended before deploying to a public VPS.
STUDIO_ADMIN_PASSWORD=""

# HMAC secret for signing session cookies when STUDIO_ADMIN_PASSWORD is enabled
SESSION_SECRET="replace_with_session_hmac_secret"

# Maximum video upload size in MB (default: 500)
MAX_UPLOAD_MB=500

# Optional comma-separated allowed origins for CORS
ALLOWED_CORS_ORIGIN=""

# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
