# ==========================================
# FRONTEND (Netlify) Environment Variable
# ==========================================
# Point to your deployed persistent Node.js backend (e.g., https://livecast-backend.onrender.com)
# Leave empty ONLY when running the unified local dev server on http://localhost:3000.
# NEVER put secrets or stream keys in VITE_* variables!
VITE_API_BASE_URL=""

# ==========================================
# BACKEND (Render / VPS / Local Server)
# ==========================================
PORT=3000
NODE_ENV=development

# Comma-separated frontend origins allowed for CORS & WebSockets
ALLOWED_CORS_ORIGIN="https://streamkarolive.netlify.app"

# 32+ byte secret used to encrypt stored Facebook RTMP stream keys (AES-256-GCM)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="replace_with_32_byte_random_hex_secret"

# Optional: Set a studio operator password to require authentication on API & WebSocket routes.
STUDIO_ADMIN_PASSWORD=""

# HMAC secret for signing session cookies when STUDIO_ADMIN_PASSWORD is enabled
SESSION_SECRET="replace_with_session_hmac_secret"

# Maximum video upload size in MB (default: 500)
MAX_UPLOAD_MB=500

# GEMINI_API_KEY: Required if AI Studio Gemini API features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
