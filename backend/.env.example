# Server Port (Render sets PORT automatically; defaults to 3000)
PORT=3000
NODE_ENV=production

# Comma-separated frontend origins allowed for CORS and WebSocket upgrades
ALLOWED_CORS_ORIGIN="https://streamkarolive.netlify.app"

# 32+ byte secret used to encrypt Facebook RTMP stream keys at rest (AES-256-GCM)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="replace_with_64_hex_chars"

# Optional bearer token for non-browser CLI automation (browser dashboard uses strict Origin + X-Livecast-Client checks)
BACKEND_ACCESS_TOKEN=""

# Maximum video upload size in MB
MAX_UPLOAD_MB=500
