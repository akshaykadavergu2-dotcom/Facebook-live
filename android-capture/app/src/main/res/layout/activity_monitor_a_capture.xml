<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/monitorAWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <LinearLayout
        android:id="@+id/monitorAErrorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_orange"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMonitorAError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FEF2F2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMonitorClearError"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Clear Error"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC050812"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvMonitorAState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="MONITOR A · LIVE"
            android:textColor="#67E8F9"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMonitorPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Pause"
            android:textAllCaps="false"
            android:textColor="@color/studio_text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnMonitorMute"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Mute"
            android:textAllCaps="false"
            android:textColor="@color/studio_text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnMonitorReload"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Reload"
            android:textAllCaps="false"
            android:textColor="@color/studio_text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnMonitorOpenYt"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Open YT"
            android:textAllCaps="false"
            android:textColor="#93C5FD"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnMonitorStopCapture"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_btn_stop_live"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Stop"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
