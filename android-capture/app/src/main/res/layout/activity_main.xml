<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/studio_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/studio_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVECAST ANDROID CAPTURE"
                    android:textColor="@color/studio_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/studio_emerald"
                    android:paddingLeft="8dp"
                    android:paddingTop="3dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="3dp"
                    android:text="LIVE CAPTURE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Captures ONLY the dedicated fullscreen Monitor A YouTube view (MediaProjection + permitted AudioPlaybackCapture). Excludes browser chrome and dashboard controls."
                android:textColor="@color/studio_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Session Inputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/studio_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Backend URL"
                android:textColor="@color/studio_text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etBackendUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/studio_surface_alt"
                android:hint="https://facebook-live-gvx5.onrender.com"
                android:inputType="textUri"
                android:padding="10dp"
                android:text="https://facebook-live-gvx5.onrender.com"
                android:textColor="@color/studio_text_primary"
                android:textColorHint="@color/studio_text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Session ID"
                android:textColor="@color/studio_text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etSessionId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/studio_surface_alt"
                android:hint="cap_..."
                android:inputType="text"
                android:padding="10dp"
                android:textColor="@color/studio_text_primary"
                android:textColorHint="@color/studio_text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ephemeral Ingest Token"
                android:textColor="@color/studio_text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etIngestToken"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/studio_surface_alt"
                android:hint="Paste 48-hex ingest token from studio"
                android:inputType="textPassword"
                android:padding="10dp"
                android:textColor="@color/studio_text_primary"
                android:textColorHint="@color/studio_text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Monitor A YouTube Live / Video URL"
                android:textColor="@color/studio_text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etYoutubeUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/studio_surface_alt"
                android:hint="https://www.youtube.com/watch?v=... or /live/..."
                android:inputType="textUri"
                android:padding="10dp"
                android:textColor="@color/studio_text_primary"
                android:textColorHint="@color/studio_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnConnectBackend"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/studio_blue"
                android:text="CONNECT ANDROID TO BACKEND"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStartCapture"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/studio_emerald"
                android:text="START CAPTURE (MONITOR A)"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopCapture"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/studio_rose"
                android:text="STOP CAPTURE"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Real-Time Honest Telemetry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/studio_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE CAPTURE TELEMETRY"
                android:textColor="@color/studio_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermissionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Capture Permission: Not Granted"
                android:textColor="@color/studio_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Backend Connection: Disconnected"
                android:textColor="@color/studio_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVideoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Video Status: IDLE"
                android:textColor="@color/studio_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAudioStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Audio Status: IDLE"
                android:textColor="@color/studio_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStreamMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Metrics: 0 fps · 0x0 · 0 Hz · 0 ms"
                android:textColor="@color/studio_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvErrorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FDA4AF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
