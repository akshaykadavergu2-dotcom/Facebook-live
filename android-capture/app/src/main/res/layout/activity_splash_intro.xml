<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03050B">

    <com.livecast.capture.SplashIntroView
        android:id="@+id/splashIntroView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btnSkipIntro"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_pill_unselected"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/skip_intro"
        android:textAllCaps="false"
        android:textColor="@color/studio_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

</FrameLayout>
